{
  "name": "electron-vite-vue-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.example.myapp",
    "productName": "MyElectronApp",
    "files": [
      "dist/**",
      "electron/**",
      "node_modules/**",
      "bin/**/*",
      "package.json",
      "!**/*.ts",
      "!**/*.map",
      "!**/tests/**/*"
    ],
    "asar": true,
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electronmon electron/main.js\"",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "start": "electron electron/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pako": "^2.0.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.4",
    "sass": "^1.97.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vue": "^3.5.26",
    "vue-tsc": "^3.2.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "pako": "^2.1.0",
    "pinia": "^3.0.4",
    "vue3-virtual-scroller": "^0.2.3"
  }
}
